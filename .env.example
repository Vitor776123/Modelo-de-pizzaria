# Supabase (projeto Leonidas) — Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada no webhook e nos links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Avisos no celular (npm run gerar-chaves)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@exemplo.com

# Mercado Pago (opcional: sem isso o PIX vira chave/QR manual confirmado pela equipe)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
